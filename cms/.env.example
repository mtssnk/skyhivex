DATABASE_URL=mongodb://127.0.0.1:27017/skyhivex
PAYLOAD_SECRET=your-secret-here
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# Full URL including protocol — in production: https://your-web-domain.up.railway.app
WEB_URL=http://localhost:4321

# Shared with web/.env — generate with: node -e "console.log(crypto.randomUUID())"
PREVIEW_SECRET=

# Cloudflare R2 — see CLAUDE.md for setup instructions
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=skyhivex-cms
R2_ENDPOINT=
R2_PUBLIC_URL=

# Railway — triggers a web service redeploy on publish (Pages/Projects/Posts/Navigations/globals).
# Leave unset locally; the hook silently no-ops if any of these are missing.
# RAILWAY_API_TOKEN: Railway dashboard → Account/Team Settings → Tokens
# RAILWAY_WEB_SERVICE_ID: the web service's ID — visible in its dashboard URL (/service/<id>)
RAILWAY_API_TOKEN=
RAILWAY_WEB_SERVICE_ID=

# RAILWAY_ENVIRONMENT_ID is auto-injected by Railway into every deployed service — do NOT set it
# manually on the live CMS service (Railway will warn about overwriting it). Only needed here for
# local testing of the deploy hook, where nothing injects it automatically.
RAILWAY_ENVIRONMENT_ID=
