DATABASE_URL=mongodb://127.0.0.1:27017/skyhivex
PAYLOAD_SECRET=your-secret-here
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# Full URL including protocol — in production: https://your-web-domain.up.railway.app
WEB_URL=http://localhost:4321

# Shared with web/.env — generate with: node -e "console.log(crypto.randomUUID())"
PREVIEW_SECRET=

# Cloudflare R2 — see CLAUDE.md for setup instructions
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=skyhivex-cms
R2_ENDPOINT=
R2_PUBLIC_URL=

# GitHub — triggers a web rebuild on publish (Pages/Projects/Posts/Navigations/globals) by
# committing a timestamp to web/.build-trigger, which Railway's GitHub integration then
# builds on push. Leave unset locally; the hook silently no-ops if any of these are missing.
# SKYHIVEX_DEPLOY_GITHUB_TOKEN: github.com/settings/tokens → Generate new token (fine-grained).
#   - Repository access: "Only select repositories" → select this repo specifically (not all repos)
#   - Permissions → Repository permissions → Contents: Read and write (this is the only permission
#     needed; leave Actions, Administration, etc. unchecked)
#   A classic PAT with the "repo" scope also works, but is broader than necessary.
# GITHUB_REPO: "owner/repo" only — e.g. mtssnk/skyhivex, NOT the full https://github.com/... URL
SKYHIVEX_DEPLOY_GITHUB_TOKEN=
GITHUB_REPO=
# Defaults to "main" if unset.
GITHUB_BRANCH=
