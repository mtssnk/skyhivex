# Root — monorepo-level ignores
# Sub-packages (cms/, web/) have their own .gitignore files

# Dependencies
node_modules/
.pnpm-store

# Environment variables
.env
.env.local
.env.*.local

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Editor
.vscode/settings.json
.vscode/launch.json
*.suo
*.ntvs*
*.njsproj
*.sln

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Misc
*.pem
.cache

# Database backups / migration dumps — contain production data, never commit
backups/
r2-migration-temp/

# One-off migration scripts get real credentials pasted into them locally — never commit
scripts/migrate-r2.sh
scripts/restore-content-to-production.sh
