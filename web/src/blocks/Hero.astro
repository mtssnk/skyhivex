---
import clsx from 'clsx'
import type { HeroBlock } from '@/lib/payload'
import MediaItem from '@/components/MediaItem.astro'
import Button from '@/components/Button.astro'
import SlideArrow from '@/components/SlideArrow.astro'
import Play from '@/assets/icons/play.astro'
import HexShader from '@/components/HexShader.astro'
import { resolveButtonHref } from '@/lib/blocks'
import { lexicalToHtml } from '@/lib/lexical'

interface Props extends Omit<HeroBlock, 'blockType'> {
  as?: 'header' | 'section'
}

const {
  headingPart1,
  headingPart2,
  headingTag,
  intro,
  body,
  backgroundMedia,
  backgroundImage,
  backgroundVideo,
  overlayAlpha,
  buttons,
  anchorId,
  size,
  as = 'header',
} = Astro.props

const bgMedia =
  backgroundMedia === 'image'
    ? backgroundImage
    : backgroundMedia === 'video'
      ? backgroundVideo
      : null

const bodyHtml = body ? lexicalToHtml(body) : null

const sizeClasses: Record<NonNullable<HeroBlock['size']>, string> = {
  large: 'min-h-[100vh]',
  medium: 'min-h-[70vh]',
  small: 'min-h-[40vh]',
}

const Tag = as === 'section' ? 'section' : 'header'
const HeadingTag = (headingTag ?? (as === 'section' ? 'h2' : 'h1')) as 'h1' | 'h2' | 'h3' | 'h4'
---

<Tag
  id={anchorId ?? undefined}
  data-hero-animate
  class={clsx(
    as === 'section' ? 'section-cta' : 'section-hero',
    'relative flex items-center bg-night text-white overflow-hidden',
    sizeClasses[size ?? 'large'],
    backgroundMedia === 'hexagon' && 'bg-hexagon-obsidian',
  )}
>
  {
    bgMedia ? (
      <div class="hero-media-in absolute inset-0" aria-hidden="true">
        <MediaItem
          media={bgMedia}
          sizes="100vw"
          muted
          priority
          crops={[{ media: '(orientation: landscape)', ratio: 16 / 9 }, { ratio: 4 / 5 }]}
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-black" style={`opacity: ${overlayAlpha ?? 0.4}`} />
      </div>
    ) : backgroundMedia === 'shader' ? (
      <HexShader />
    ) : null
  }

  <div class="container relative py-sm flex flex-col items-center text-center gap-5xs">
    {
      backgroundMedia === 'shader' && (
        <div
          class="absolute inset-0 z-0 pointer-events-none"
          style="background: radial-gradient(ellipse at center, rgba(0,0,0,0.4) 0%, rgba(0,0,0,0) 70%)"
          aria-hidden="true"
        />
      )
    }
    <div class="relative z-10 space-y-2xs">
      <div class="space-y-5xs">
        {
          headingPart1 || headingPart2 ? (
            <HeadingTag class="text-white space-y-5xs" data-hero-heading>
              {headingPart1 && (
                <span
                  class="text-extended-lg uppercase w-full inline-flex justify-center max-w-[28em] text-balance"
                  data-hero-part
                >
                  {headingPart1}
                </span>
              )}
              {headingPart2 && (
                <p class="text-serif-5xl w-full inline-flex justify-center" data-hero-part>
                  {headingPart2}
                </p>
              )}
            </HeadingTag>
          ) : null
        }
        {
          intro && (
            <p class="text-extended-md mx-auto max-w-[24em] text-balance" data-hero-fade>
              {intro}
            </p>
          )
        }
        {
          bodyHtml && (
            <div
              class="wysiwyg text-body-sm mx-auto max-w-[36em] text-balance"
              data-hero-fade
              set:html={bodyHtml}
            />
          )
        }
      </div>
      {
        buttons && buttons.length > 0 && (
          <div class="flex flex-wrap gap-y-4 gap-3xs items-center justify-center" data-hero-fade>
            {buttons.map((btn) => {
              if (btn.type === 'video') {
                return (
                  <Button
                    colour={btn.colour}
                    style={btn.variant}
                    size="lg"
                    data-video-url={btn.videoFile?.url ?? ''}
                  >
                    {btn.label}
                    <Play />
                  </Button>
                )
              }
              const href =
                btn.type === 'anchor'
                  ? `#${btn.anchorTarget ?? ''}`
                  : resolveButtonHref(btn.linkUrl)
              return (
                <Button href={href} colour={btn.colour} style={btn.variant} size="lg">
                  {btn.label}
                  {btn.type === 'anchor' && <SlideArrow direction="down-right" />}
                </Button>
              )
            })}
          </div>
        )
      }
    </div>
  </div>
</Tag>

<style is:global>
  @media (prefers-reduced-motion: no-preference) {
    /* JS-driven content reveal: only hide when JS can animate it back in.
       No-JS or reduced-motion visitors see the content immediately. GSAP
       takes over with inline styles once the block scrolls into view. */
    .js [data-hero-animate] [data-hero-heading],
    .js [data-hero-animate] [data-hero-fade] {
      opacity: 0;
    }

    /* Background media / shader canvas: pure-CSS fade on load. No JS
       dependency; replays on every navigation because Astro swaps in a fresh
       element. `both` fill-mode applies the 0% opacity from first paint, so
       there's no flash of the media before it fades. */
    .section-hero .hero-media-in {
      animation: hero-media-in 700ms 1000ms ease-out both;
    }
  }

  @keyframes hero-media-in {
    from {
      opacity: 0;
    }
  }
</style>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  import { SplitText } from 'gsap/SplitText'

  gsap.registerPlugin(ScrollTrigger, SplitText)

  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches

  let cleanup: (() => void) | null = null
  let generation = 0

  function teardown() {
    generation += 1
    cleanup?.()
    cleanup = null
  }

  async function setup() {
    teardown()
    if (reduced) return

    const myGen = generation
    const section = document.querySelector<HTMLElement>('[data-hero-animate]')
    if (!section) return

    // Line splitting depends on the final font — splitting before it loads
    // produces the wrong line breaks.
    await document.fonts.ready
    // A newer navigation may have superseded this run while we awaited.
    if (myGen !== generation || !document.body.contains(section)) return

    const heading = section.querySelector<HTMLElement>('[data-hero-heading]')
    const parts = Array.from(section.querySelectorAll<HTMLElement>('[data-hero-part]'))
    const fades = Array.from(section.querySelectorAll<HTMLElement>('[data-hero-fade]'))

    const ctx = gsap.context(() => {
      const splits = parts.map((el) =>
        SplitText.create(el, { type: 'lines', mask: 'lines', linesClass: 'hero-line' }),
      )
      const lines = splits.flatMap((s) => s.lines)

      const delay = 0.8

      // Build the timeline paused and add every tween BEFORE attaching the
      // ScrollTrigger. Passing `scrollTrigger` to gsap.timeline() creates the
      // trigger up front; if the hero is already in view (e.g. straight after a
      // client-side navigation) it fires synchronously, before the later tweens
      // exist — which is why the fades only ran on the first load.
      const tl = gsap.timeline({ paused: true, defaults: { ease: 'power3.out' } })

      if (heading) tl.set(heading, { autoAlpha: 1 }, 0)
      // GSAP owns the fades' hidden state (not just the CSS fallback), so it is
      // re-applied on every rebuild after a navigation.
      if (fades.length) tl.set(fades, { autoAlpha: 0 }, 0)
      if (lines.length) {
        tl.from(lines, { yPercent: 100, duration: 0.8, stagger: 0.15, ease: 'power4.out' }, delay)
      }
      if (fades.length) {
        tl.to(fades, { autoAlpha: 1, duration: 1.2, stagger: 0.15 }, lines.length ? '>-0.3' : delay)
      }

      ScrollTrigger.create({
        trigger: section,
        start: 'top 80%',
        once: true,
        onEnter: () => tl.play(),
      })

      // Reverted by ctx.revert(): restores the original heading markup.
      return () => splits.forEach((s) => s.revert())
    }, section)

    cleanup = () => ctx.revert()
  }

  // Runs on the initial load and after every client-side navigation; teardown
  // before each swap so SplitText's injected markup isn't diffed/persisted.
  document.addEventListener('astro:page-load', setup)
  document.addEventListener('astro:before-swap', teardown)
</script>
