---
import Layout from '@/layouts/Layout.astro'
import BlockRenderer from '@/blocks/BlockRenderer.astro'
import { getPageBySlug } from '@/lib/payload'
import type { City, State, Region } from '@/lib/payload'

export const prerender = false

const { slug } = Astro.params
const isPreview = Astro.cookies.get('__preview')?.value === 'true'
if (!isPreview) return Astro.redirect(`/${slug ?? ''}`)

const apiKey = import.meta.env.PAYLOAD_API_KEY as string
const page = await getPageBySlug(slug!, { draft: true, apiKey })
if (!page) return new Response(null, { status: 404 })

function buildAreaServed(
  cities?: City[] | null,
  states?: State[] | null,
  regions?: Region[] | null,
): object[] | undefined {
  if (cities?.length) {
    return cities.map((c) => ({ '@type': 'City', name: c.name }))
  }
  if (states?.length) {
    return states.map((s) => ({ '@type': 'State', name: s.name }))
  }
  if (regions?.length) {
    return regions.map((r) => ({ '@type': 'AdministrativeArea', name: r.name }))
  }
  return undefined
}

const areaServed = buildAreaServed(page.cities, page.states, page.regions)

const jsonLd = areaServed
  ? {
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      name: page.title,
      ...(page.metaDescription ? { description: page.metaDescription } : {}),
      areaServed,
    }
  : undefined
---

<Layout
  title={page.title}
  description={page.metaDescription ?? undefined}
  ogImage={page.ogImage?.url ?? undefined}
  jsonLd={jsonLd}
  isPreview={isPreview}
>
  <BlockRenderer blocks={page.blocks} />
</Layout>
