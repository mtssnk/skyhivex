---
import Layout from '@/layouts/Layout.astro'
import BlockRenderer from '@/blocks/BlockRenderer.astro'
import { getPostBySlug } from '@/lib/payload'
import Hero from '@/blocks/Hero.astro'

export const prerender = false

Astro.response.headers.set('Cache-Control', 'no-store')

const { slug } = Astro.params
const isPreview = Astro.cookies.get('__preview')?.value === 'true'
if (!isPreview) return Astro.redirect(`/news/${slug ?? ''}`)

const apiKey = import.meta.env.PAYLOAD_API_KEY as string
const post = await getPostBySlug(slug!, { draft: true, apiKey })
if (!post) return new Response(null, { status: 404 })

const metaDescription = post.metaDescription ?? post.intro ?? post.title
const ogImage = post.ogImage?.url ?? post.listingImage?.url ?? undefined

const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: post.title,
  description: metaDescription,
  url: Astro.url.href,
  ...(ogImage ? { image: ogImage } : {}),
}
---

<Layout title={post.title} description={metaDescription} {ogImage} {jsonLd} isPreview={isPreview}>
  <Hero
    headingPart1={post.title}
    backgroundMedia="image"
    backgroundImage={post.listingImage}
    overlayAlpha={post.overlayAlpha}
    size="large"
  />
  <BlockRenderer blocks={post.blocks} />
</Layout>
