---
import PostView from '@/components/PostView.astro'
import { getPostBySlug } from '@/lib/payload'

export const prerender = false

Astro.response.headers.set('Cache-Control', 'no-store')

const { slug } = Astro.params
if (Astro.cookies.get('__preview')?.value !== 'true') return Astro.redirect(`/news/${slug ?? ''}`)

const post = await getPostBySlug(slug!, {
  draft: true,
  apiKey: import.meta.env.PAYLOAD_API_KEY as string,
})
if (!post) return new Response(null, { status: 404 })
---

<PostView {post} isPreview />
