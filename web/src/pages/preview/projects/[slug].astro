---
import ProjectView from '@/components/ProjectView.astro'
import { getProjectBySlug } from '@/lib/payload'

export const prerender = false

Astro.response.headers.set('Cache-Control', 'no-store')

const { slug } = Astro.params
if (Astro.cookies.get('__preview')?.value !== 'true') return Astro.redirect(`/projects/${slug ?? ''}`)

const project = await getProjectBySlug(slug!, {
  draft: true,
  apiKey: import.meta.env.PAYLOAD_API_KEY as string,
})
if (!project) return new Response(null, { status: 404 })
---

<ProjectView {project} isPreview />
