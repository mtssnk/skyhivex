<canvas class="w-full h-full z-0 absolute inset-0" id="canvas"></canvas>

<script>
  import { createRenderer } from '../lib/shader-renderer.js'
  import fragSrc from '../lib/hex-shader.frag?raw'

  const MAX_PIXEL_RATIO = 1.5

  let renderer: ReturnType<typeof createRenderer> | null = null
  let onVisibilityChange: (() => void) | null = null

  function cleanup() {
    if (onVisibilityChange) {
      document.removeEventListener('visibilitychange', onVisibilityChange)
      onVisibilityChange = null
    }
    renderer?.destroy()
    renderer = null
  }

  function main() {
    // Navigating away and back re-fires this (astro:page-load) with a brand-new
    // <canvas>, but the module itself only ever evaluates once per browser session
    // under the client router — so any previous renderer must be torn down here
    // rather than relying on the script re-running from scratch.
    cleanup()

    const canvas = document.getElementById('canvas') as HTMLCanvasElement | null
    if (!canvas) return

    try {
      renderer = createRenderer(canvas, fragSrc, {
        maxPixelRatio: MAX_PIXEL_RATIO,
      })
    } catch (err) {
      showError(`WebGL / shader error:\n${(err as Error).message}`)
      return
    }

    renderer.start()

    onVisibilityChange = () => {
      document.hidden ? renderer?.stop() : renderer?.start()
    }
    document.addEventListener('visibilitychange', onVisibilityChange)
  }

  function showError(msg: string) {
    const el = document.createElement('pre')
    Object.assign(el.style, {
      position: 'fixed',
      inset: '2rem',
      background: 'rgba(0,0,0,.85)',
      color: '#f66',
      padding: '1.5rem',
      borderRadius: '6px',
      whiteSpace: 'pre-wrap',
      font: '13px/1.5 monospace',
    })
    el.textContent = msg
    document.body.appendChild(el)
    console.error(msg)
  }

  document.addEventListener('astro:page-load', main)
</script>
